<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daycmd.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/node@24/bin/npm</string>
        <string>run</string>
        <string>start:prod</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/isaacwright/Documents/Personal/Projects/Daycmd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>ENABLE_SCHEDULER</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/isaacwright/Library/Logs/daycmd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/isaacwright/Library/Logs/daycmd.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
