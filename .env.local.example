# =============================================================================
# Daycmd — local environment config
# =============================================================================
# Copy this file to `.env.local` and fill in the blanks.
# `.env.local` is gitignored. Never commit secrets.
# Restart `npm run dev` after editing.
# =============================================================================

# ---- Obsidian -----------------------------------------------------------
# Absolute path to your Obsidian vault. Tasks pulled from <VAULT_PATH>/Tasks/*.md.
# Daily notes read/written at <VAULT_PATH>/Daily/YYYY-MM-DD.md.
VAULT_PATH="/Users/yourname/Documents/Your Vault"


# ---- GitHub -------------------------------------------------------------
# Classic PAT: github.com/settings/tokens (Generate new token → classic)
# Scopes required: repo, notifications, read:user
# Format: ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_TOKEN=


# ---- Google (Gmail + Calendar) ------------------------------------------
# 1. console.cloud.google.com → New project
# 2. APIs & Services → Enable: Gmail API + Google Calendar API
# 3. OAuth consent screen → External, add yourself as test user
# 4. Credentials → Create OAuth client ID → Web application
#    Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# 5. Paste client id + secret below, restart dev, click "Connect Google" in UI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# ---- Anthropic (agent panel) --------------------------------------------
# console.anthropic.com → API Keys → Create Key
# Format: sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...
ANTHROPIC_API_KEY=


# =============================================================================
# Optional
# =============================================================================

# ---- Scheduler gate -----------------------------------------------------
# instrumentation.ts early-returns unless this is set. Leave unset for
# foreground dev. Set =1 for the launchd service or to test crons in dev.
# ENABLE_SCHEDULER=1

